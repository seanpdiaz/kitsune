# Copy this to .env and fill in real values. .env itself is gitignored (and
# excluded from `npm run deploy` — see scripts/deploy-exclude.txt), so it's
# set up once per environment, not synced from your local machine.

# ---------------------------------------------------------------------------
# Database — see server/db.js and wiki/Persistence-and-Logging.md
#
# DB_CLIENT selects which database backs the whole app: "sqlite" (the
# default when unset) needs nothing else below — it's Node's built-in
# node:sqlite, a single file under data/kitsune.db, zero setup. Set it to
# "postgres" to point Kitsune at a real Postgres server instead, using the
# DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD/DB_SSL vars below. Every table,
# route, and query works identically either way; switching this is the only
# change needed to move from a zero-config local install to a real deployed
# database.
# ---------------------------------------------------------------------------
DB_CLIENT=sqlite

# Only read when DB_CLIENT=postgres.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kitsune
DB_USER=kitsune
DB_PASSWORD=
# Set to "true" for a managed/remote Postgres (RDS, etc.) reached over a
# connection whose certificate chain this process doesn't have. Leave unset
# for a local/LAN Postgres — the common case for a self-hosted install.
DB_SSL=

# Required for TVDB-backed search/metadata lookups.
TVDB_API_KEY=

# Required for MyAnimeList-backed search.
MAL_CLIENT_ID=

# APP_ENV controls whether an empty database gets demo data seeded into it.
# On a completely empty database, series.js/tags.js/settings-items.js each
# seed a small set of fake defaults (demo anime, demo tags, demo indexers/
# connections/quality profiles) so there's something to click through.
#
# "production" (the default when unset) leaves an empty database genuinely
# empty — nothing gets auto-seeded just because a table happens to be empty.
# This is what you want for any real, ongoing install: if your library ever
# ends up empty (a fresh volume, a restored backup, cleaning up after a
# recovery), it stays empty instead of quietly repopulating itself with demo
# anime nobody added. Set APP_ENV=demo to get the old zero-config "there's
# already something to click through" behavior back — that's for trying the
# app out or local dev, not for a real deployment.
APP_ENV=production
