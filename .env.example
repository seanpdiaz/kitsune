# Copy this to .env and fill in real values. .env itself is gitignored (and
# excluded from `npm run deploy` — see scripts/deploy-exclude.txt), so it's
# set up once per environment, not synced from your local machine.

# Required for TVDB-backed search/metadata lookups.
TVDB_API_KEY=

# Required for MyAnimeList-backed search.
MAL_CLIENT_ID=

# Demo data: on a completely empty database, series.js/tags.js/
# settings-items.js each seed a small set of fake defaults (demo anime,
# demo tags, demo indexers/connections/quality profiles) so there's
# something to click through right away. Defaults to true (unset = seeded),
# which is what you want for local dev or trying the app out. Set this to
# false on a real deployment so a fresh database starts genuinely empty
# instead of with anime nobody added.
SEED_DEMO_DATA=true
